# Installed inside the image by `npm ci`; copying the host's copy is slow and
# can carry platform-specific binaries that do not run in the container.
node_modules
dist
dist-ssr

# The whole backend tree would otherwise be sent as build context for an image
# that only needs the frontend.
backend

.git
.github
.claude
.vscode
.idea

# Secrets must never reach an image layer.
.env
.env.*
!.env.example
!.env.production.example
!.env.docker.example

*.log
npm-debug.log*
coverage
schema
README.md
