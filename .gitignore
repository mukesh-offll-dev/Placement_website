# Environment / secrets — NEVER commit real credentials
.env
.env*
*.env
.env.local
.env.*.local
backend/.env
backend/.env*
backend/*.local
# Keep the templates tracked, at any depth. The patterns above also matched
# .env.production.example and .env.docker.example, so they were being ignored
# silently; the *.example forms below cover any new template too.
!.env.example
!**/.env.example
!*.env.example
!**/*.env.example
!.env.*.example
!**/.env.*.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
