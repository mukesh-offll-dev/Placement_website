# ============================================================
# Environment Variables — Placement Cell Backend
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------ Database (PostgreSQL — PROD profile) ------
DB_URL=jdbc:postgresql://localhost:5432/placement_cell
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# ------ Spring Profile ------
# Use 'dev' for H2 (no setup needed), 'prod' for PostgreSQL
SPRING_PROFILES_ACTIVE=dev

# ------ JWT ------
# Required for the prod profile. Generate with: openssl rand -base64 32
# JWT_SECRET=replace_with_a_random_256_bit_base64_string
# JWT_EXPIRATION=PT15M
# JWT_REFRESH_EXPIRATION_MS=604800000

# ------ Optional one-time student provisioning ------
# Set both only when creating a new student account; password must be 12+ characters.
# STUDENT_PROVISION_EMAIL=student@example.edu
# STUDENT_PROVISION_PASSWORD=replace_with_a_unique_password

# ------ CORS ------
# Comma-separated list of allowed frontend origins
# Required in prod, e.g. APP_CORS_ALLOWED_ORIGINS=https://placement.example.edu

# ------ Server ------
# SERVER_PORT=8080
