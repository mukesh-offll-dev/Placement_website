# ============================================================
# Environment Variables — Placement Cell Backend
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------ Database (PostgreSQL) ------
# Required. There is no in-memory fallback: the app talks to PostgreSQL only.
# DB_URL takes precedence; DATABASE_URL is accepted as a fallback for hosts
# (Neon, Render, Railway) that inject that name.
# For a hosted database remember the TLS parameter, e.g.
#   jdbc:postgresql://<host>/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/placement_cell
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# ------ Schema ------
# No variables to set. src/main/resources/schema.sql is the single source of DDL
# truth and runs on every startup; every statement is CREATE TABLE IF NOT EXISTS,
# so an existing database is left untouched. Hibernate's ddl-auto is 'none', so
# entities never alter the schema — edit schema.sql and the entity together.

# ------ JWT (not wired up yet; no security layer exists) ------
# JWT_SECRET=replace_with_random_256_bit_base64_string
# JWT_EXPIRATION_MS=86400000
# JWT_REFRESH_EXPIRATION_MS=604800000

# ------ CORS (not wired up yet) ------
# Comma-separated list of allowed frontend origins
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ------ Server ------
# SERVER_PORT=8080
