# ============================================================
# Environment Variables — Placement Cell Backend
# ============================================================
# Copy this file to .env (or .env.local) and fill in real values.
# NEVER commit .env to version control!
# ============================================================

# ------------------------------------------------------------
# 1. Spring Environment & Server Profile
# ------------------------------------------------------------
# Active Spring profile:
#   'default' = standard configuration with local defaults
#   'prod'    = strict production profile (enforces environment variables)
SPRING_PROFILES_ACTIVE=default

# Server port (PaaS hosts like Render, Heroku, Railway inject PORT automatically)
SERVER_PORT=8080
PORT=8080

# Servlet context path (default: /api)
SERVER_SERVLET_CONTEXT_PATH=/api

# ------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / Neon / Render / Railway)
# ------------------------------------------------------------
# Full JDBC URL:
# For local PostgreSQL:
DB_URL=jdbc:postgresql://localhost:5432/placement_cell

# For cloud-hosted PostgreSQL (Neon, Supabase, Render, Railway, AWS RDS):
# Always append ?sslmode=require for secure TLS connections.
# Example:
# DB_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloud platform URI fallback:
# If your platform automatically injects DATABASE_URL in URI format (e.g.,
# postgres://user:password@host:port/database), DotEnvPostProcessor will
# automatically parse and convert it into a compliant JDBC URL.
# DATABASE_URL=postgres://your_user:your_password@ep-example.aws.neon.tech/placement_cell?sslmode=require

DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# Database Driver class (auto-detected if blank)
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# HikariCP Connection Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=600000
DB_POOL_CONNECTION_TIMEOUT=30000

# Hibernate DDL Auto: keep 'none' for production (DDL managed via schema.sql)
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false

# SQL Schema Initialization:
#   'always' = executes schema.sql on startup (safe with CREATE TABLE IF NOT EXISTS)
#   'never'  = disables automatic DDL execution (if using external migration tools)
SPRING_SQL_INIT_MODE=always

# H2 In-Memory Database Web Console (strictly false in production)
SPRING_H2_CONSOLE_ENABLED=false

# ------------------------------------------------------------
# 3. JWT Security Configuration
# ------------------------------------------------------------
# Secret key for HMAC-SHA256 JWT signing.
# CRITICAL: In production, generate a secure random 256-bit (or higher) string.
# Minimum 32 characters (256 bits).
# Generate securely via terminal:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secure_secret_key_minimum_32_characters_for_production

# Access token validity duration in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Refresh token validity duration in milliseconds (default: 604800000 = 7 days)
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.com

# ------------------------------------------------------------
# 5. File Storage Configuration
# ------------------------------------------------------------
# Directory for uploaded documents (resumes, project media)
FILE_UPLOAD_DIR=./uploads
FILE_RESUME_SUBDIR=resumes
FILE_PROJECT_MEDIA_SUBDIR=projects
FILE_MAX_RESUME_SIZE=10485760
FILE_MAX_MEDIA_SIZE=10485760
FILE_MAX_UPLOAD_SIZE=15MB
FILE_MAX_REQUEST_SIZE=20MB

# ------------------------------------------------------------
# 6. Admin & Sample Data Bootstrap Configuration
# ------------------------------------------------------------
# Set to 'false' in production to disable sample student and dummy job creation
APP_DATA_INIT_ENABLED=false

# Initial Administrator account (created on startup if no admin exists)
DEFAULT_ADMIN_EMAIL=admin@gces.edu
DEFAULT_ADMIN_PASSWORD=ChangeMeOnFirstLogin@2026!
DEFAULT_ADMIN_NAME=Placement Officer

# ------------------------------------------------------------
# 6b. Email alerts to eligible students when a job is posted
# ------------------------------------------------------------
# Leave APP_MAIL_ENABLED=false to post jobs without sending any email.
# For Gmail use smtp.gmail.com:587 with an App Password (not your login password).
APP_MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mailbox@example.com
MAIL_PASSWORD=your_smtp_app_password
# Sender shown to students (defaults to MAIL_USERNAME when blank)
MAIL_FROM=
# Base URL used for the "View and apply" link in the email
APP_FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# 7. Logging & Actuator Health Monitoring
# ------------------------------------------------------------
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_WEB=WARN
LOGGING_LEVEL_ROOT=INFO

# Actuator health details: 'never', 'when-authorized', or 'always'
MANAGEMENT_HEALTH_SHOW_DETAILS=when-authorized
