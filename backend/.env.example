# ============================================================
# Environment Variables — Placement Cell Backend
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------ Database (PostgreSQL — PROD profile) ------
DB_URL=jdbc:postgresql://localhost:5432/placement_cell
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# ------ Spring Profile ------
# Use 'dev' for H2 (no setup needed), 'prod' for PostgreSQL
SPRING_PROFILES_ACTIVE=dev

# ------ JWT (will be added when auth is implemented) ------
# JWT_SECRET=replace_with_random_256_bit_base64_string
# JWT_EXPIRATION_MS=86400000
# JWT_REFRESH_EXPIRATION_MS=604800000

# ------ CORS ------
# Comma-separated list of allowed frontend origins
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ------ Server ------
# SERVER_PORT=8080
