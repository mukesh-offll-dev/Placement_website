# ============================================================
# docker compose environment
# ============================================================
# Copy to .env in this directory, then: docker compose up --build
#
#   cp .env.docker.example .env
#
# .env is gitignored. The two variables without defaults below have none on
# purpose — compose stops with a named error rather than starting the stack
# with a guessable password or signing key.
# ============================================================

# ------ Database ------
POSTGRES_DB=placement_cell
POSTGRES_USER=placement
# Required.
POSTGRES_PASSWORD=choose_a_strong_database_password

# ------ Backend ------
# Required. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# 'default' for local use, 'prod' to require every value from the environment.
SPRING_PROFILES_ACTIVE=default

# Only consulted for direct cross-origin API calls; through the frontend the
# requests are same-origin.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Seed an admin account on an empty database. Leave false once real accounts
# exist; change the password immediately if you turn it on.
APP_DATA_INIT_ENABLED=false
DEFAULT_ADMIN_EMAIL=admin@gces.edu
DEFAULT_ADMIN_PASSWORD=ChangeMeOnFirstLogin@2026!

# ------ Frontend ------
# Host port for the site.
FRONTEND_PORT=3000

# Relative keeps the browser on one origin via the nginx /api proxy. Set an
# absolute URL only when the API is served from a different domain — and then
# add that origin to APP_CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=/api
