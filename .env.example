# ============================================================
# Environment Variables Example — Placement Cell
# ============================================================
# Copy this file to .env (or .env.local) and fill in real values.
# NEVER commit .env to version control!
# ============================================================

# ------------------------------------------------------------
# 1. Frontend Configuration (Vite / React)
# ------------------------------------------------------------
# Spring Boot Backend API Base URL
# Backend context path is /api, server runs on port 8080 by default.
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------
# 2. Backend Configuration (Spring Boot)
# See backend/.env.example for comprehensive documentation
# ------------------------------------------------------------
SPRING_PROFILES_ACTIVE=default
SERVER_PORT=8080
PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api

# Database Configuration (PostgreSQL / Neon / Render / Railway)
DB_URL=jdbc:postgresql://localhost:5432/placement_cell
DB_USERNAME=your_postgres_username
DB_PASSWORD=your_postgres_password

# JWT Security Configuration (HMAC-SHA256, minimum 32 characters / 256 bits)
JWT_SECRET=replace_with_a_long_random_secure_secret_key_minimum_32_characters_for_production
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated URLs, no trailing slash)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Data Initialization (Set to false in production)
APP_DATA_INIT_ENABLED=false

# File Upload Directory
FILE_UPLOAD_DIR=./uploads
